{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "ignoreCommand": "if [ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git cat-file -e \"$VERCEL_GIT_PREVIOUS_SHA\" 2>/dev/null; then git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- .; else exit 1; fi",
  "regions": [
    "icn1"
  ],
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "https://naegajjanday-api.onrender.com/v1/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://naegajjanday-api.onrender.com/uploads/:path*"
    }
  ]
}
