{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "regions": ["icn1"],
  "rewrites": [
    { "source": "/v1/:path*", "destination": "https://naegajjanday-api.onrender.com/v1/:path*" },
    { "source": "/uploads/:path*", "destination": "https://naegajjanday-api.onrender.com/uploads/:path*" }
  ]
}
