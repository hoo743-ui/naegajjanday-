{
  "name": "@naegajjanday/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "preview:phone": "node scripts/phone-preview.mjs",
    "preview:prod": "node scripts/prod-preview.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript http://localhost:8000/v1/openapi.json -o src/lib/api/schema.gen.ts",
    "msw:init": "msw init public/ --save",
    "e2e": "playwright test",
    "verify": "node e2e/site-cycle.mjs",
    "verify:record": "node e2e/site-cycle.mjs --record && node e2e/site-cycle.mjs --record --intersect",
    "e2e:report": "playwright show-report"
  },
  "overrides": {
    "postcss": "^8.5.28"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@sun-typeface/suit": "^2.0.5",
    "@tanstack/react-query": "^5.103.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "next": "^15.5.25",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
