# apps/api/.env 로 복사해서 쓴다 (uvicorn / pytest / cli 를 apps/api 에서 직접 돌릴 때).
# 루트의 .env(.example) 는 docker compose · Makefile · scripts/dev.ps1 용이다.
# 변수 이름과 기본값의 정본은 app/core/config.py. 전부 비워 둬도 SQLite + 메모리 캐시로 뜬다.

# ── app ──────────────────────────────────────────
# local | test | staging | production
APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=false
PUBLIC_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
# 쉼표 구분
CORS_ORIGINS=http://localhost:3000

# ── storage (비우면 폴백) ─────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# DATABASE_URL=postgresql+asyncpg://naegajjanday:naegajjanday@localhost:5432/naegajjanday
# 없으면 프로세스 메모리 캐시 · rate limit
REDIS_URL=
# 없으면 SQL LIKE 검색
ES_URL=
ES_USERNAME=
ES_PASSWORD=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ── security ─────────────────────────────────────
JWT_SECRET=local-dev-only-change-me-0123456789abcdef
COOKIE_SECURE=false
WEBHOOK_SECRET=
RATE_LIMIT_ENABLED=true

# ── 보관 기한 (화면에서 한 약속. celery beat 또는 cron: python -m app.cli purge-courses / purge-accounts) ──
# 저장하지 않은 코스를 지우기까지(시간)
UNSAVED_COURSE_TTL_HOURS=24
# 탈퇴 신청 뒤 계정·개인정보를 완전히 지우기까지(일)
ACCOUNT_PURGE_GRACE_DAYS=30

# ── OAuth2 로그인 (키가 있는 제공자만 활성) ────────
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── LLM (none 이면 템플릿 문장으로 폴백) ───────────
# anthropic | openai | gemini | none
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
NARRATIVE_INLINE_LLM=false

# ── 장소 수집: 공식 Open API 만 ────────────────────
KAKAO_REST_API_KEY=
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
GOOGLE_PLACES_API_KEY=
TOURAPI_SERVICE_KEY=
DATA_GO_KR_SERVICE_KEY=
# 공연(연극·뮤지컬·콘서트) — 공연예술통합전산망 KOPIS Open API. https://www.kopis.or.kr/por/cs/openapi/openApiInfo.do 에서 신청.
# 비워 두면 GET /v1/performances 는 available=false 로 답하고 외부 호출을 하지 않는다.
KOPIS_API_KEY=

# ── 이동시간 (haversine 은 키 불필요) ──────────────
# haversine | kakao | tmap | google
TRAVEL_TIME_PROVIDER=haversine
KAKAO_MOBILITY_API_KEY=
TMAP_APP_KEY=
GOOGLE_ROUTES_API_KEY=

# ── analytics ────────────────────────────────────
# none | ga4 | posthog | mixpanel
ANALYTICS_PROVIDER=none
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
POSTHOG_API_KEY=
MIXPANEL_TOKEN=
