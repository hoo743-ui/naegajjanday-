"use client";

import { useMemo, useState } from "react";
import { useFormContext, useWatch } from "react-hook-form";
import { useQuery } from "@tanstack/react-query";
import {
  Car,
  Check,
  ChevronDown,
  CloudRain,
  Compass,
  Footprints,
  Heart,
  Leaf,
  ListChecks,
  MapPin,
  Moon,
  Palette,
  PiggyBank,
  Plus,
  Route,
  Sparkles,
  TrainFront,
  Trees,
  Trophy,
  Utensils,
  Wallet,
  Wine,
  X,
  type LucideIcon,
} from "lucide-react";
import { ErrorState, EmptyState } from "@/components/mascot/EmptyState";
import { Skeleton } from "@/components/ui/skeleton";
import { track } from "@/lib/analytics";
import { api } from "@/lib/api/client";
import { useLocalSignature, useTags } from "@/lib/api/hooks";
import { FOCUS_OFF, type Tag, type Transport } from "@/lib/api/types";
import { localSummary, type InterpretInput, type MoveStyle, type Pace, type SummaryLine, type Wish } from "@/lib/preference";
import { cn } from "@/lib/utils";
import type { PlanValues } from "./schema";

/*
 * docs/30: 취향 단계를 세 개의 짧은 질문으로 나눴다. 사용자는 큰 방향만 고르고, 해석은 API 가 한다.
 * 기본 단계는 크고 분명한 선택 카드(선택: 파란 테두리 · 옅은 파란 바탕 · 체크), 세부 설정은 "더 자세히" 안의 작은 칩.
 * 아무것도 고르지 않아도 다음으로 갈 수 있다.
 */

const choice =
  "relative flex w-full cursor-pointer items-start gap-3.5 rounded-[20px] border bg-paper p-4 text-left transition-[border-color,background-color,box-shadow] duration-200 sm:p-5";
const choiceOff = "border-line hover:border-ink/30";
const choiceOn = "border-blue-deep bg-blue-soft shadow-soft ring-1 ring-blue-deep/30";

function Tick({ on }: { on: boolean }) {
  return (
    <span aria-hidden className={cn("ml-auto grid size-6 shrink-0 place-items-center rounded-full border", on ? "border-blue-deep bg-blue-deep text-white" : "border-line bg-white text-transparent")}>
      <Check className="size-3.5" />
    </span>
  );
}

// ── 4. 어떤 하루 ───────────────────────────────────────────────
const PACES: { value: Pace; label: string; hint: string; icon: LucideIcon }[] = [
  { value: "relaxed", label: "여유롭게", hint: "들르는 곳은 적게, 한 곳에 오래", icon: Leaf },
  { value: "packed", label: "알차게", hint: "시간 안에서 여러 곳을 촘촘히", icon: ListChecks },
  { value: "foodie", label: "맛있는 거 중심", hint: "식사에 예산을 더, 동네 맛집 위주", icon: Utensils },
  { value: "special", label: "특별한 경험", hint: "해 보는 것 · 볼거리 위주, 체인점은 덜", icon: Sparkles },
];
const MAX_PACE = 2;

export function DayStep() {
  const { setValue } = useFormContext<PlanValues>();
  const pace = useWatch<PlanValues, "pace">({ name: "pace" });
  const toggle = (value: Pace) => {
    const on = pace.includes(value);
    // 세 번째를 고르면 가장 먼저 고른 것이 빠진다 (막지 않는다)
    const next = on ? pace.filter((p) => p !== value) : [...pace, value].slice(-MAX_PACE);
    setValue("pace", next, { shouldDirty: true });
    // "특별한 경험"은 기존의 "재미 우선" 스타일로 읽힌다
    setValue("style", next.includes("special") ? "fun" : "efficient", { shouldDirty: true });
    if (!on) track("preference_style_selected", { pace: value });
  };
  const both = pace.includes("relaxed") && pace.includes("packed");
  return (
    <div className="grid gap-4">
      <p className="text-body-sm text-ink-2">하나나 두 개. 안 골라도 짠이가 균형 있게 짜요.</p>
      <div role="group" aria-label="어떤 하루" className="grid gap-3 sm:grid-cols-2">
        {PACES.map((p) => {
          const on = pace.includes(p.value);
          return (
            <button key={p.value} type="button" role="checkbox" aria-checked={on} onClick={() => toggle(p.value)} className={cn(choice, on ? choiceOn : choiceOff)}>
              <p.icon aria-hidden className="mt-0.5 size-6 shrink-0 text-blue-deep" />
              <span className="min-w-0">
                <b className="block text-body-lg font-bold text-ink">{p.label}</b>
                <span className="mt-0.5 block text-body-sm text-muted-foreground">{p.hint}</span>
              </span>
              <Tick on={on} />
            </button>
          );
        })}
      </div>
      {both ? (
        <p className="rounded-card bg-paper-2 px-4 py-3 text-body-sm text-ink-2" aria-live="polite">
          여유롭게 + 알차게: 들르는 곳 수는 그대로 두고, 한 곳 한 곳을 더 알차게 골라요.
        </p>
      ) : null}
    </div>
  );
}

// ── 5. 얼마나 이동 ─────────────────────────────────────────────
const MOVES: { value: MoveStyle; label: string; hint: string; icon: LucideIcon }[] = [
  { value: "local", label: "가까운 곳 위주", hint: "고른 동네 안에서 짧게 이어요", icon: MapPin },
  { value: "balanced", label: "적당히 이동", hint: "동네와 바로 옆 생활권까지", icon: Route },
  { value: "explorer", label: "좋은 곳이라면 조금 멀어도 OK", hint: "갈 만한 곳이면 한 정거장 더 가요", icon: Compass },
];
// 약속이 아니라 보통의 모습: 엔진은 구간을 자르지 않고, 길어질수록 조금씩 점수를 잃게 한다 (docs/29)
const TRANSPORTS: { value: Transport; label: string; hint: string; icon: LucideIcon }[] = [
  { value: "walk", label: "걸어서", hint: "한 구간 보통 15분 안팎", icon: Footprints },
  { value: "transit", label: "대중교통", hint: "한 구간 보통 25분 안팎", icon: TrainFront },
  { value: "car", label: "자동차", hint: "한 구간 보통 25분 안팎", icon: Car },
];

export function MoveStep() {
  const { setValue } = useFormContext<PlanValues>();
  const move = useWatch<PlanValues, "move_style">({ name: "move_style" });
  const transport = useWatch<PlanValues, "transport">({ name: "transport" });
  return (
    <div className="grid gap-6">
      <div role="radiogroup" aria-label="얼마나 이동해도 괜찮아요?" className="grid gap-3">
        {MOVES.map((m) => {
          const on = move === m.value;
          return (
            <button
              key={m.value}
              type="button"
              role="radio"
              aria-checked={on}
              onClick={() => {
                setValue("move_style", m.value, { shouldDirty: true });
                track("travel_preference_selected", { move_style: m.value });
              }}
              className={cn(choice, "items-center", on ? choiceOn : choiceOff)}
            >
              <m.icon aria-hidden className="size-6 shrink-0 text-blue-deep" />
              <span className="min-w-0">
                <b className="block text-body-lg font-bold text-ink">{m.label}</b>
                <span className="mt-0.5 block text-body-sm text-muted-foreground">{m.hint}</span>
              </span>
              <Tick on={on} />
            </button>
          );
        })}
      </div>
      <div>
        <p className="mb-2 text-body-sm font-semibold text-ink-2">어떻게 다녀요?</p>
        <div role="radiogroup" aria-label="어떻게 다녀요?" className="grid grid-cols-3 gap-2">
          {TRANSPORTS.map((t) => {
            const on = transport === t.value;
            return (
              <button
                key={t.value}
                type="button"
                role="radio"
                aria-checked={on}
                onClick={() => setValue("transport", t.value, { shouldDirty: true })}
                className={cn("flex flex-col items-center gap-1 rounded-2xl border px-2 py-3 text-center transition-colors", on ? choiceOn : cn("bg-paper", choiceOff))}
              >
                <t.icon aria-hidden className="size-5 text-blue-deep" />
                <b className="text-body-sm font-bold text-ink">{t.label}</b>
                <span className="text-caption text-muted-foreground">{t.hint}</span>
              </button>
            );
          })}
        </div>
      </div>
    </div>
  );
}

// ── 6. 꼭 원하는 것 ─────────────────────────────────────────────
const WISHES: { value: Wish; label: string; icon: LucideIcon }[] = [
  { value: "night", label: "야경", icon: Moon },
  { value: "walk", label: "산책", icon: Trees },
  { value: "exhibition", label: "전시", icon: Palette },
  { value: "value", label: "가성비", icon: PiggyBank },
  { value: "romantic", label: "로맨틱", icon: Heart },
];
/** 세부 태그 묶음의 순서와 이름 (API 의 group 코드 → 화면 이름) */
const GROUP_ORDER = ["activity", "food", "mood", "feature"] as const;
const GROUP_LABEL: Record<string, string> = { activity: "놀거리", food: "음식", mood: "분위기", feature: "편의 · 조건" };

type TagState = "none" | "like" | "avoid";

export function WishStep({ detailsOpen, onDetails }: { detailsOpen: boolean; onDetails: (open: boolean) => void }) {
  const { setValue } = useFormContext<PlanValues>();
  const wishes = useWatch<PlanValues, "wishes">({ name: "wishes" });
  const toggle = (value: Wish) => {
    const on = wishes.includes(value);
    setValue("wishes", on ? wishes.filter((w) => w !== value) : [...wishes, value], { shouldDirty: true });
    track("quick_preference_selected", { wish: value, on: !on });
  };
  return (
    <div className="grid gap-5">
      <p className="text-body-sm text-ink-2">없으면 그냥 넘어가도 돼요.</p>
      <div role="group" aria-label="꼭 반영하고 싶은 것" className="flex flex-wrap gap-2.5">
        {WISHES.map((w) => {
          const on = wishes.includes(w.value);
          return (
            <button
              key={w.value}
              type="button"
              aria-pressed={on}
              onClick={() => toggle(w.value)}
              className={cn("inline-flex min-h-12 items-center gap-2 rounded-full border px-5 text-body font-semibold transition-colors", on ? "border-blue-deep bg-blue-soft text-blue-deep" : "border-line bg-paper text-ink hover:border-ink/30")}
            >
              {on ? <Check aria-hidden className="size-4" /> : <w.icon aria-hidden className="size-4 text-blue-deep" />}
              {w.label}
            </button>
          );
        })}
      </div>

      <button
        type="button"
        aria-expanded={detailsOpen}
        aria-controls="plan-details"
        onClick={() => {
          if (!detailsOpen) track("advanced_preference_opened", {});
          onDetails(!detailsOpen);
        }}
        className="inline-flex w-fit items-center gap-1.5 rounded-full px-1 py-2 text-body-sm font-semibold text-blue-deep"
      >
        {detailsOpen ? <ChevronDown aria-hidden className="size-4" /> : <Plus aria-hidden className="size-4" />}
        {detailsOpen ? "자세한 설정 접기" : "더 자세히"}
      </button>
      {detailsOpen ? <Details /> : null}
    </div>
  );
}

function Toggle({ on, onChange, icon: Icon, title, hint }: { on: boolean; onChange: (v: boolean) => void; icon: LucideIcon; title: string; hint: string }) {
  return (
    <label className="flex cursor-pointer items-center gap-3.5 border-b border-dashed border-line py-3.5 last:border-b-0">
      <input type="checkbox" className="peer sr-only" checked={on} onChange={(e) => onChange(e.target.checked)} />
      <Icon aria-hidden className="size-5 shrink-0 text-blue-deep" />
      <span className="min-w-0 flex-1">
        <b className="block text-body font-semibold text-ink">{title}</b>
        <span className="block text-caption text-muted-foreground">{hint}</span>
      </span>
      <span aria-hidden className={cn("grid size-6 shrink-0 place-items-center rounded-md border peer-focus-visible:ring-2 peer-focus-visible:ring-blue-deep", on ? "border-blue-deep bg-blue-deep text-white" : "border-line bg-white text-transparent")}>
        <Check className="size-3.5" />
      </span>
    </label>
  );
}

/** "더 자세히": 예전 취향 화면의 모든 것 — 그날의 사정 · 동네 명물 · 세부 태그(좋아요/피할래요) */
function Details() {
  const { setValue } = useFormContext<PlanValues>();
  const liked = useWatch<PlanValues, "liked_tags">({ name: "liked_tags" });
  const disliked = useWatch<PlanValues, "disliked_tags">({ name: "disliked_tags" });
  const focus = useWatch<PlanValues, "focus">({ name: "focus" });
  const withBar = useWatch<PlanValues, "with_bar">({ name: "with_bar" });
  const rainy = useWatch<PlanValues, "rainy">({ name: "rainy" });
  const withBaseball = useWatch<PlanValues, "with_baseball">({ name: "with_baseball" });
  const region = useWatch<PlanValues, "region">({ name: "region" });
  const tags = useTags();
  const local = useLocalSignature(region || undefined);
  const specialties = local.data?.specialties ?? [];

  const groups = useMemo(() => {
    const map = new Map<string, Tag[]>();
    for (const tag of tags.data?.items ?? []) map.set(tag.group, [...(map.get(tag.group) ?? []), tag]);
    const rank = (g: string) => (GROUP_ORDER as readonly string[]).indexOf(g) + 1 || 99;
    return [...map.entries()].sort((a, b) => rank(a[0]) - rank(b[0])).map(([g, items]) => [items[0]?.group_name ?? GROUP_LABEL[g] ?? g, items] as const);
  }, [tags.data]);

  const stateOf = (name: string): TagState => (liked.includes(name) ? "like" : disliked.includes(name) ? "avoid" : "none");
  const cycle = (name: string) => {
    const state = stateOf(name);
    const without = (list: string[]) => list.filter((t) => t !== name);
    setValue("liked_tags", state === "none" ? [...liked, name] : without(liked), { shouldDirty: true });
    setValue("disliked_tags", state === "like" ? [...disliked, name] : without(disliked), { shouldDirty: true });
    track("advanced_preference_selected", { tag: name, state: state === "none" ? "like" : state === "like" ? "avoid" : "none" });
  };

  return (
    <div id="plan-details" className="grid gap-4">
      <section className="rounded-card border border-line bg-white px-5 py-1">
        <h3 className="sr-only">그날의 사정</h3>
        <Toggle on={rainy} onChange={(v) => setValue("rainy", v, { shouldDirty: true })} icon={CloudRain} title="비 오는 날이에요" hint="실내 위주로 짜요. 산책 대신 전시 · 실내 놀거리를 넣어요." />
        <Toggle on={withBar} onChange={(v) => setValue("with_bar", v, { shouldDirty: true })} icon={Wine} title="술 한잔 포함" hint="저녁 5시 이후에 술집 한 곳을 꼭 넣어요. 예산도 떼어 둘게요." />
        <Toggle on={withBaseball} onChange={(v) => setValue("with_baseball", v, { shouldDirty: true })} icon={Trophy} title="야구 보러 가요" hint="1군 구장이 있는 동네면 넣어요. 경기 일정은 직접 확인해 주세요." />
      </section>

      {specialties.length > 0 ? (
        <fieldset className="rounded-card border border-line bg-white p-5">
          <legend className="float-left mb-1 w-full text-body-sm font-semibold text-ink-2">{local.data?.region}에 왔다면</legend>
          <p className="clear-both mb-3 text-body-sm text-muted-foreground">이 동네 간판에 유독 많이 걸린 말이에요. 하나 고르면 그 집을 꼭 넣어요.</p>
          <div className="flex flex-wrap gap-2" role="radiogroup" aria-label="꼭 넣을 동네 명물">
            {[{ value: "", label: "짠이가 알아서", hint: "" }, ...specialties.map((s) => ({ value: s.word, label: s.word, hint: `${s.count}곳` })), { value: FOCUS_OFF, label: "상관없어요", hint: "" }].map((o) => {
              const on = focus === o.value;
              return (
                <button key={o.value || "auto"} type="button" role="radio" aria-checked={on} onClick={() => setValue("focus", o.value, { shouldDirty: true })} className={cn("inline-flex items-center gap-1.5 rounded-full border px-3.5 py-2 text-body-sm font-semibold", on ? "border-blue-deep bg-blue-soft text-blue-deep" : "border-line bg-paper text-ink hover:border-ink/30")}>
                  {o.label}
                  {o.hint ? <span className="tabular text-caption text-muted-foreground">{o.hint}</span> : null}
                </button>
              );
            })}
          </div>
        </fieldset>
      ) : null}

      <section className="rounded-card border border-line bg-white p-5">
        <h3 className="text-body-sm font-semibold text-ink-2">세부 취향</h3>
        <p className="mt-1 mb-3 text-caption text-muted-foreground">
          한 번 누르면 <b className="text-blue-deep">좋아요</b>, 한 번 더 누르면 <b className="text-pink-deep">피할래요</b>, 또 누르면 해제돼요.
        </p>
        {tags.isPending ? (
          <div className="flex flex-wrap gap-2" aria-busy="true">
            {Array.from({ length: 8 }, (_, i) => (
              <Skeleton key={i} className="h-9 w-20 rounded-full" />
            ))}
          </div>
        ) : tags.isError ? (
          <ErrorState error={tags.error} onRetry={() => void tags.refetch()} size="sm" />
        ) : groups.length === 0 ? (
          <EmptyState size="sm" title="고를 태그가 아직 없어요" description="세부 취향 없이도 코스는 잘 나와요." />
        ) : (
          <div className="divide-y divide-dashed divide-line">
            {groups.map(([group, items]) => {
              const picked = items.filter((t) => stateOf(t.name) !== "none").length;
              return (
                <details key={group} className="group py-2.5" open={picked > 0}>
                  <summary className="flex cursor-pointer list-none items-center justify-between gap-3 py-1 text-body-sm font-semibold text-ink [&::-webkit-details-marker]:hidden">
                    <span>
                      {group}
                      {picked > 0 ? <span className="tabular ml-2 text-caption font-semibold text-blue-deep">{picked}개 고름</span> : null}
                    </span>
                    <ChevronDown aria-hidden className="size-4 text-muted-foreground transition-transform group-open:rotate-180" />
                  </summary>
                  <div role="group" aria-label={group} className="flex flex-wrap gap-2 pt-2 pb-1">
                    {items.map((tag) => {
                      const state = stateOf(tag.name);
                      return (
                        <button
                          key={tag.code ?? tag.name}
                          type="button"
                          onClick={() => cycle(tag.name)}
                          aria-label={`${tag.name}: ${state === "like" ? "좋아요" : state === "avoid" ? "피할래요" : "선택 안 함"}`}
                          className={cn(
                            "rounded-full border px-3.5 py-1.5 text-body-sm font-semibold transition-colors",
                            state === "like" && "border-blue-deep bg-blue-soft text-blue-deep",
                            state === "avoid" && "border-pink-deep bg-pink-soft text-pink-deep line-through",
                            state === "none" && "border-line bg-paper text-ink-2 hover:border-ink/30",
                          )}
                        >
                          {state === "like" ? <Heart aria-hidden className="mr-1 -mt-0.5 inline size-3.5 fill-current" /> : null}
                          {state === "avoid" ? <X aria-hidden className="mr-1 -mt-0.5 inline size-3.5" /> : null}
                          {tag.name}
                        </button>
                      );
                    })}
                  </div>
                </details>
              );
            })}
          </div>
        )}
      </section>
    </div>
  );
}

// ── 확인 ─────────────────────────────────────────────────────
const LINE_ICON: Record<SummaryLine["kind"], LucideIcon> = { pace: Leaf, move: Route, wish: Sparkles, detail: ListChecks, budget: Wallet };

/** 세 질문이 끝나면 한 번 확인한다: "좋아요. 이렇게 이해했어요." — 내부 값이 아니라 말로 (docs/30 §10) */
export function ConfirmView({ input }: { input: InterpretInput }) {
  const fallback = localSummary(input);
  const understood = useQuery({
    queryKey: ["interpret", input],
    queryFn: () => api.post<{ summary: SummaryLine[] }>("/courses/interpret", input, { timeoutMs: 6000 }),
    staleTime: 60_000,
    retry: 1,
  });
  const lines = understood.data?.summary?.length ? understood.data.summary : fallback;
  return (
    <div className="receipt-wrap">
      <ul aria-label="이렇게 이해했어요" className="receipt divide-y divide-dashed divide-ink/15 px-6 py-3">
        {lines.map((line) => {
          const Icon = LINE_ICON[line.kind] ?? Check;
          return (
            <li key={`${line.kind}-${line.key}`} className="flex items-center gap-3 py-3.5">
              <Icon aria-hidden className={cn("size-5 shrink-0", line.kind === "budget" ? "text-gold-ink" : "text-blue-deep")} />
              <span className={cn("text-body-lg text-ink", line.kind === "budget" ? "tabular font-bold" : "font-semibold")}>{line.text}</span>
            </li>
          );
        })}
      </ul>
    </div>
  );
}
