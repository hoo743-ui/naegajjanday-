# Copy to .env - used by docker-compose.yml (interpolation + env_file), the
# Makefile and scripts/dev.ps1. Never commit .env.
# Variable names follow apps/api/app/core/config.py and apps/web/.env.example.

# ── docker compose: infrastructure ───────────────────────────────
POSTGRES_USER=naegajjanday
POSTGRES_PASSWORD=naegajjanday
POSTGRES_DB=naegajjanday
POSTGRES_PORT=5432
REDIS_PORT=6379
ES_PORT=9200
ES_VERSION=8.15.3
ES_JAVA_OPTS=-Xms512m -Xmx512m

# ── docker compose: application (profile "app") ──────────────────
API_PORT=8000
WEB_PORT=3000
# SQLite without Alembic: "python -m app.cli db init" (create_all) also works.
API_MIGRATE_CMD=alembic upgrade head
CELERY_APP=app.workers.celery_app
CELERY_CONCURRENCY=2

# ── api running on the HOST (make api-dev / scripts/dev.ps1 api-dev) ─
# Inside compose these four are overridden with the service host names.
APP_ENV=local
LOG_JSON=false
DATABASE_URL=postgresql+asyncpg://naegajjanday:naegajjanday@localhost:5432/naegajjanday
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
ES_URL=http://localhost:9200

# ── secrets (leave empty to disable the feature) ─────────────────
JWT_SECRET=local-dev-only-change-me-0123456789abcdef
WEBHOOK_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
KAKAO_REST_API_KEY=
TOURAPI_SERVICE_KEY=

# ── web (build-time, see apps/web/.env.example for the full list) ─
NEXT_PUBLIC_KAKAO_MAP_KEY=
